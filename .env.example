# LLMプロバイダ: ollama(デフォルト・ローカル) | openai | gemini
LLM_PROVIDER=ollama

# --- Ollama (ローカル・デフォルト) ---
OLLAMA_LLM=qwen2.5:14b
# 軽量・高速にしたい場合は qwen2.5:7b（ツール呼び出しがやや不安定）
OLLAMA_EMBED=nomic-embed-text

# --- OpenAI に切り替える場合 (uv pip install -e ".[openai]") ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBED=text-embedding-3-small

# --- Gemini に切り替える場合 (uv pip install -e ".[gemini]") ---
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_EMBED=models/text-embedding-004

# --- 評価ジャッジだけ別プロバイダにする (任意) ---
# エージェントはローカル(ollama)のまま、評価の信頼性だけ上げたいとき。
# JUDGE_PROVIDER=openai   # 例: 評価ジャッジのみ OpenAI（要 OPENAI_API_KEY と [openai] extra）

# --- 監視 (任意・Langfuse) ---
# LANGFUSE_ENABLED=1
# LANGFUSE_PUBLIC_KEY=pk-...
# LANGFUSE_SECRET_KEY=sk-...
# LANGFUSE_HOST=https://cloud.langfuse.com
